{
  "version": 2,
  "builds": [
    {
      "src": "app/server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/server.py"
    }
  ]
}
