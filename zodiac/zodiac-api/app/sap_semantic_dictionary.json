  "dimensions": {
    "vendor": { "entity": "vendor", "table": "LFA1", "column": "lifnr", "name_column": "name1" },
    "customer": { "entity": "customer", "table": "KNA1", "column": "kunnr", "name_column": "name1" },
    "material": { "entity": "material", "table": "LIPS", "column": "matnr", "name_table": "MAKT", "name_column": "maktx" },
