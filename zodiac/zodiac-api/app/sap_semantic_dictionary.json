    "gl_account": { "entity": "finance", "table": "FAGLFLEXA", "column": "racct" },
    "company_code": { "entity": "finance", "table": "FAGLFLEXA", "column": "rbukrs" }
  },
  "templates": {
    "count_by_dimension": "SELECT {dimension}, COUNT(*) AS cnt FROM {table} GROUP BY {dimension} ORDER BY cnt DESC LIMIT 100",
    "sum_by_dimension": "SELECT {dimension}, SUM({metric}) AS total FROM {table} GROUP BY {dimension} ORDER BY total DESC LIMIT 100",
    "sum_by_dimension_with_name": "SELECT a.{dimension}, b.{name_column} AS name, SUM(a.{metric}) AS total FROM {table} a LEFT JOIN {name_table} b ON a.{join_key} = b.{join_key} GROUP BY a.{dimension}, b.{name_column} ORDER BY total DESC LIMIT 100",
    "total_metric": "SELECT SUM({metric}) AS total FROM {table} LIMIT 1",
    "list_entities": "SELECT {key}, {name_column} FROM {table} ORDER BY {name_column} LIMIT 100"
  },
  "fallback_rules": {
    "if_metric_unknown": "use COUNT(*) AS cnt",
    "if_aggregation_missing": "SUM numeric columns from primary table",
    "if_table_unknown": "search entities by keywords then use primary_table",
    "default_limit": 100
  }
}
