    "profit_center_billing": { "entity": "sales", "table": "VBRP", "column": "prctr", "name_table": "CEPC", "name_column": "name1" },
    "customer_billing": { "entity": "customer", "table": "VBRK", "column": "kunag", "name_table": "KNA1", "name_column": "name1", "name_join_key": "kunnr", "metric_join_key": "vbeln" },
    "country": { "entity": "vendor", "table": "LFA1", "column": "land1" },
    "customer_country": { "entity": "customer", "table": "KNA1", "column": "land1" },
    "plant": { "entity": "material", "table": "LIPS", "column": "werks" },
    "storage_location": { "entity": "warehouse", "table": "LSEG", "column": "lgort" },
    "profit_center": { "entity": "finance", "table": "FAGLFLEXA", "column": "prctr", "name_table": "CEPC", "name_column": "name1" },
