  "metrics": {
    "delivery_quantity": {
      "table": "LIPS",
      "column": "lfimg",
      "aggregation": "SUM",
      "aliases": ["delivered quantity", "delivery quantity", "quantity delivered", "delivered qty"]
    },
    "delivery_value": {
      "table": "LIPS",
      "column": "netwr",
      "aggregation": "SUM",
      "aliases": ["delivery value", "delivery amount", "delivered value", "total delivery value"]
    },
    "warehouse_stock": {
      "table": "LSEG",
      "column": "menge",
      "aggregation": "SUM",
