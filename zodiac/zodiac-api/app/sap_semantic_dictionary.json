    "invoice_quantity": {
      "table": "VBRP",
      "column": "fkimg",
      "aggregation": "SUM",
      "aliases": ["invoice quantity", "invoiced quantity", "billed quantity"]
    },
    "order_value": {
      "table": "VBAP",
      "column": "netwr",
      "aggregation": "SUM",
      "aliases": ["order value", "sales order value", "order amount", "order total", "orders by customer", "order value by material", "order value by plant"]
    },
    "order_quantity": {
      "table": "VBAP",
      "column": "kwmeng",
