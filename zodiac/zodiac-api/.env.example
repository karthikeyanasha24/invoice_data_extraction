# BridgeEDI / Zodiac API — example environment (v1.0)
# Copy to .env and fill values. Never commit real secrets.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SECRET_KEY=replace-with-long-random-string
API_HASH_KEY=replace-with-long-random-string

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
DEPLOY_ENV=DEV
# DEV | STAGING | PRODUCTION — PRODUCTION enables stricter startup checks

# --- CORS (production: exact origins, CORS_ALLOW_ALL=false) ---
CORS_ORIGINS=http://localhost:3000,https://www.bridgeedi.com
CORS_ALLOW_ALL=false

# --- Database pool ---
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- BridgeEDI feature flags ---
ENABLE_PIPELINE_API=false
ENABLE_MONITORING_API=true
ENABLE_AI_OPS_API=true

# --- Secrets resolution ---
# default = env + vault providers; literal = legacy (do not use in prod)
SECRET_RESOLVER=default
# VAULT_ADDR=
# VAULT_TOKEN=
# BRIDGEEDI_VAULT_JSON={"path/to/secret":"value"}

# --- Optional: create missing tables on startup (prefer SQL migrations in prod) ---
AUTO_APPLY_ENTERPRISE_SCHEMA=false

# --- Optional: alert webhook (JSON POST) ---
# ALERT_WEBHOOK_URL=https://hooks.example.com/bridgeedi

# --- Auth ---
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Adaptive Analyst SQL time (ms). Live must not stay at 20s. ---
# ADAPTIVE_SQL_TIMEOUT_MS=120000
# ADAPTIVE_INVESTIGATION_LIMIT_SECONDS=120

# --- AI (Adaptive Query / insights — not invoice pipeline) ---
# OPEN_AI_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# ENABLE_MULTI_MODEL=false
# LANGGRAPH_OPENAI_MODEL=gpt-4o
# AI_INSIGHTS_MODEL=gpt-4o-mini
# AI_FAST_MODEL=gpt-4o-mini

# --- Optional Blob / encryption ---
# BLOB_READ_WRITE_TOKEN=
# ENCRYPTION_KEY=

# --- Pilot connector secrets (examples — match workspace env: refs) ---
# PILOT_ERP_TOKEN=
# PILOT_GOV_TOKEN=
