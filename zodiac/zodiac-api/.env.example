# BridgeEDI / Zodiac API — example environment (v1.0)
# Copy to .env and fill values. Never commit real secrets.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SECRET_KEY=replace-with-long-random-string
API_HASH_KEY=replace-with-long-random-string

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
DEPLOY_ENV=DEV
# DEV | STAGING | PRODUCTION — PRODUCTION enables stricter startup checks

# --- CORS (production: exact origins, CORS_ALLOW_ALL=false) ---
CORS_ORIGINS=http://localhost:3000,https://www.bridgeedi.com
CORS_ALLOW_ALL=false

# --- Database pool ---
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- BridgeEDI feature flags ---
ENABLE_PIPELINE_API=false
ENABLE_MONITORING_API=true
ENABLE_AI_OPS_API=true

# --- Secrets resolution ---
# default = env + vault providers; literal = legacy (do not use in prod)
SECRET_RESOLVER=default
# VAULT_ADDR=
# VAULT_TOKEN=
# BRIDGEEDI_VAULT_JSON={"path/to/secret":"value"}

# --- Optional: create missing tables on startup (prefer SQL migrations in prod) ---
AUTO_APPLY_ENTERPRISE_SCHEMA=false

# --- Optional: alert webhook (JSON POST) ---
# ALERT_WEBHOOK_URL=https://hooks.example.com/bridgeedi

# --- Auth ---
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Adaptive Analyst SQL time (ms). Live must not stay at 20s. ---
# ADAPTIVE_SQL_TIMEOUT_MS=120000

# --- AI (Adaptive Query / insights — not invoice pipeline) ---
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# AI_CHAT_PROVIDER=openai
# AI_ANALYST_MODEL=gpt-6.1-sol
# The AI page uses an OpenAI Responses tool loop by default.
# Set false to restore the legacy pipeline; other AI feature providers are separate.
AI_ANALYST_AGENT_ENABLED=true
# Basic model selection. Groq is an optional hosted free-tier pilot.
# Use a Groq Free Plan account; this flag is an operator declaration, not a
# provider billing-tier check. Quota errors stop without a paid fallback.
# BASIC_LLM_PROVIDER=groq
# GROQ_API_KEY=
# BASIC_GROQ_FREE_PLAN=true
# BASIC_GROQ_MODEL=openai/gpt-oss-20b
# BASIC_MAX_MODEL_CALLS=6
# BASIC_MAX_PROMPT_BYTES=24000
# Set false to keep untaught Basic questions from using the paid Agentic route.
# BASIC_ALLOW_PAID_FALLBACK=false
# Basic: checked SQL retrieval is always available. Set an installed Ollama model
# to investigate questions outside saved queries/templates without provider token fees.
# BASIC_LOCAL_MODEL=qwen3:4b
# BASIC_EMBED_MODEL=embeddinggemma
# BASIC_OLLAMA_URL=http://127.0.0.1:11434
# For a Vercel API, use an HTTPS reverse proxy in front of your own Ollama host.
# BASIC_OLLAMA_URL=https://your-private-model-endpoint.example
# BASIC_OLLAMA_API_KEY=
# Change when switching datasets so verified memory cannot cross extracts.
# AI_ANALYST_DATASET_VERSION=erp-extract-2026-10-12
# Optional override; otherwise uses the configured analyst model policy.
# AI_ANALYST_AGENT_MODEL=gpt-6-astra
AI_ANALYST_AGENT_REASONING_EFFORT=medium
# Optional upgrade for demanding planning; other analyst tasks keep the base model.
# AI_ANALYST_PLANNING_MODEL=gpt-6-astra
# AI_ANALYST_PLANNING_REASONING_EFFORT=medium
# AI_ANALYST_ANSWER_REASONING_EFFORT=low
# AI_ANALYST_ALLOW_PROVIDER_FALLBACK=false
# AI_LLM_CALL_TIMEOUT_SECONDS=60
# AI_ANALYST_ANSWER_MAX_TOKENS=8000
# AI_ANALYST_PLANNING_MAX_TOKENS=6000
# AI_ANALYST_UNDERSTANDING_MAX_TOKENS=3000
# ADAPTIVE_INVESTIGATION_LIMIT_SECONDS=180
# OPENROUTER_API_KEY=
# ENABLE_MULTI_MODEL=false
# Separate dashboard-insight and helper features; these do not choose the analyst model.
# AI_INSIGHTS_MODEL=gpt-5
# AI_FAST_MODEL=gpt-5-mini

# --- Optional Blob / encryption ---
# BLOB_READ_WRITE_TOKEN=
# ENCRYPTION_KEY=

# --- Pilot connector secrets (examples — match workspace env: refs) ---
# PILOT_ERP_TOKEN=
# PILOT_GOV_TOKEN=
