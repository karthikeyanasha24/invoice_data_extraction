      "case": "customer ranking",
      "question": "Show top 5 customers by billed sales.",
      "passed": true,
      "outcome": "PASS",
      "answer_status": "SUCCESS",
      "mode": "database_analysis",
      "row_count": 51,
      "service_issue": null,
      "seconds": 9.22,
      "sql_executed": true,
      "sql": "WITH grouped AS (\n  SELECT TRIM(CAST(c.\"kunnr\" AS TEXT)) AS \"customer_id\", TRIM(CAST(c.\"name1\" AS TEXT)) AS \"customer_name\", k.\"waerk\" AS \"currency\", (SUM(CAST(NULLIF(TRIM(CAST(k.\"netwr\" AS TEXT)), '') AS NUMERIC))) AS \"total_sales\"\n  FROM \"VBRK\" k\n  LEFT JOIN \"KNA1\" c ON LPAD(TRIM(CAST(k.\"kunag\" AS TEXT)), 10, '0') = LPAD(TRIM(CAST(c.\"kunnr\" AS TEXT)), 10, '0')\n  WHERE NULLIF(TRIM(CAST(k.\"kunag\" AS TEXT)), '') IS NOT NULL\n  GROUP BY TRIM(CAST(c.\"kunnr\" AS TEXT)), TRIM(CAST(c.\"name1\" AS TEXT)), k.\"waerk\"\n), ranked AS (\n  SELECT grouped.*, ROW_NUMBER() OVER (\n    PARTITION BY grouped.\"currency\" ORDER BY grouped.\"total_sales\" DESC NULLS LAST\n  ) AS \"rank_within_currency\"\n  FROM grouped\n)\nSELECT * FROM ranked\nWHERE \"rank_within_currency\" <= 5\nORDER BY \"currency\", \"rank_within_currency\"\nLIMIT 5 * (SELECT COUNT(DISTINCT \"currency\") FROM grouped)",
      "error": null,
      "error_kind": null,
      "failure_class": "SUCCESS",
      "column_names": [
        "customer_id",
        "customer_name",
        "currency",
        "total_sales",
        "rank_within_currency"
      ],
